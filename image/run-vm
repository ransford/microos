#!/bin/bash
# Boots a disk image from build-disk (raw or qcow2) in QEMU with UEFI
# firmware, on the serial console. Works on macOS (Homebrew QEMU) and Linux.
# The image is opened copy-on-write, so the file itself never changes.
# Exit with `poweroff` in the guest, or Ctrl-A X.
#
# Usage: run-vm [disk]                     (default: ~/microos.img)
set -euo pipefail

disk=${1:-$HOME/microos.img}
[ -f "$disk" ] || { echo "error: $disk not found" >&2; exit 1; }

# qcow2 files start with the magic bytes "QFI\xfb".
format=raw
[ "$(head -c 3 "$disk")" = QFI ] && format=qcow2

# OVMF (EDK II) firmware, from Homebrew's qemu formula or Ubuntu's ovmf
# package. Only the read-only code image is loaded; with no variable store
# OVMF keeps its variables in RAM, which is fine for a disk that boots from
# the removable-media path.
brew_prefix=$(command -v brew >/dev/null && brew --prefix qemu || true)
firmware=
for f in "$brew_prefix/share/qemu/edk2-x86_64-code.fd" \
  /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd; do
  if [ -f "$f" ]; then firmware=$f; break; fi
done
[ -n "$firmware" ] || { echo "error: no x86_64 OVMF firmware found (brew install qemu, or apt install ovmf)" >&2; exit 1; }

# Hardware acceleration only works when the host is x86_64 too: KVM on Linux,
# HVF on Intel Macs. On Apple silicon it's software emulation (TCG), which is
# slower but fine for a shell. QEMU falls back to TCG if the first fails.
accel=(-accel tcg)
case $(uname -s)/$(uname -m) in
  Linux/x86_64) [ -e /dev/kvm ] && accel=(-accel kvm "${accel[@]}") ;;
  Darwin/x86_64) accel=(-accel hvf "${accel[@]}") ;;
esac

# -cpu max: see run-qemu. panic=-1 on the kernel command line plus -no-reboot
# makes QEMU exit instead of hanging if the kernel panics.
exec qemu-system-x86_64 "${accel[@]}" -machine q35 -cpu max -m 512M \
  -nographic -no-reboot \
  -drive if=pflash,format=raw,readonly=on,file="$firmware" \
  -drive if=virtio,format="$format",file="$disk",snapshot=on
