#cloud-config
hostname: ${hostname}

package_update: true
package_upgrade: true
packages:
  # Kernel build toolchain
  - build-essential
  - bc
  - bison
  - flex
  - cpio
  - dwarves
  - kmod
  - libelf-dev
  - libncurses-dev
  - libssl-dev
  - rsync
  - xz-utils
  - zstd
  - ccache
  # initramfs build (image/build-initramfs) and test boots
  - bzip2
  - fakeroot
  - qemu-system-x86
  # VM disk image (image/build-disk, push-oci, run-vm)
  - dosfstools
  - fdisk
  - mtools
  - ovmf
  - qemu-utils
  - systemd-boot-efi
  - systemd-ukify
  # General tooling
  - curl
  - git
  - jq
  - pkg-config

write_files:
  # image/push-oci, make-ami and coldsnap read the region from here.
  - path: /etc/profile.d/aws-region.sh
    content: |
      export AWS_REGION=${region} AWS_DEFAULT_REGION=${region}
  # Installs oras (OCI artifact client) from its GitHub release. To change
  # versions, update both lines; the checksum is in the release's
  # oras_<version>_checksums.txt.
  - path: /usr/local/sbin/install-oras
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      ORAS_VERSION=1.3.4
      ORAS_SHA256=f27adb935022d94df8dc77719c322dda592c78a0d57a6f7dcdd8d900b248c454
      tarball=oras_$${ORAS_VERSION}_linux_amd64.tar.gz
      cd "$(mktemp -d)"
      curl -fsSLo "$tarball" "https://github.com/oras-project/oras/releases/download/v$ORAS_VERSION/$tarball"
      echo "$ORAS_SHA256  $tarball" | sha256sum -c --quiet -
      tar -xzf "$tarball" oras
      install -m 0755 oras /usr/local/bin/oras
  # Joins the tailnet using the auth key stored in SSM Parameter Store.
  # Runs on every boot; a no-op when already connected, and re-authenticates
  # if an ephemeral node was dropped from the tailnet while offline.
  - path: /usr/local/sbin/tailscale-bootstrap
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      if ! command -v tailscale >/dev/null; then
        curl -fsSL https://tailscale.com/install.sh | sh
      fi
      systemctl enable --now tailscaled
      state=$(tailscale status --json 2>/dev/null | jq -r .BackendState || true)
      if [ "$state" = "Running" ]; then
        exit 0
      fi
      if ! command -v aws >/dev/null; then
        snap install aws-cli --classic
      fi
      key=$(aws ssm get-parameter --region ${region} --name ${ts_key_param} \
        --with-decryption --query Parameter.Value --output text)
      tailscale up --auth-key="$key" --hostname=${hostname}
  - path: /etc/systemd/system/tailscale-bootstrap.service
    content: |
      [Unit]
      Description=Join the tailnet with the auth key from SSM
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
      ExecStart=/usr/local/sbin/tailscale-bootstrap
      Restart=on-failure
      RestartSec=15

      [Install]
      WantedBy=multi-user.target
  # Downloads the latest stable kernel tarball into ~/linux-<ver>, with ~/linux
  # symlinked to it. Re-run any time to pick up a newer release.
  - path: /usr/local/bin/fetch-latest-kernel
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      cd "$HOME"
      releases=$(curl -fsSL https://www.kernel.org/releases.json)
      ver=$(jq -r .latest_stable.version <<<"$releases")
      url=$(jq -r --arg v "$ver" '.releases[] | select(.version == $v) | .source' <<<"$releases")
      if [ ! -d "linux-$ver" ]; then
        tarball=$(basename "$url")
        echo "Fetching Linux $ver from $url"
        curl -fsSLo "$tarball" "$url"
        # kernel.org publishes sha256sums.asc next to each tarball. With no
        # matching line, sha256sum -c fails too.
        curl -fsSL "$(dirname "$url")/sha256sums.asc" |
          awk -v f="$tarball" '$2 == f' | sha256sum -c -
        tar -xJf "$tarball"
        rm "$tarball"
      fi
      ln -sfn "linux-$ver" linux

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now tailscale-bootstrap.service
  - command -v aws >/dev/null || snap install aws-cli --classic
  - /usr/local/sbin/install-oras
  - sudo -u ubuntu -H bash -c "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
  - sudo -u ubuntu -H /usr/local/bin/fetch-latest-kernel
  # Uploads disk images straight to EBS snapshots (image/make-ami). Last, as
  # compiling it takes a few minutes.
  - sudo -u ubuntu -H bash -c "~/.cargo/bin/cargo install --locked coldsnap"
